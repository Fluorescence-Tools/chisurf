/* ===== Standard MDI subwindows (fallback) ===== */
QMdiSubWindow::close-button,
QMdiSubWindow::minimize-button,
QMdiSubWindow::maximize-button {
    background-color: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid rgba(255, 255, 255, 0.80) !important;
    border-radius: 2px;
    margin: 2px;
    width: 14px;
    height: 14px;
}

QToolButton#qt_mdi_closebutton,
QToolButton#qt_mdi_minimizebutton,
QToolButton#qt_mdi_maximizebutton,
QToolButton#qt_mdi_restorebutton {
    background-color: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid rgba(255, 255, 255, 0.80) !important;
    border-radius: 2px;
    margin: 2px;
    padding: 0;
    qproperty-autoRaise: false;
}

QMdiSubWindow::minimize-button:hover,
QMdiSubWindow::maximize-button:hover {
    background-color: rgba(0, 0, 0, 0.55) !important;
}

QToolButton#qt_mdi_minimizebutton:hover,
QToolButton#qt_mdi_maximizebutton:hover,
QToolButton#qt_mdi_restorebutton:hover {
    background-color: rgba(0, 0, 0, 0.55) !important;
}

QMdiSubWindow::minimize-button:pressed,
QMdiSubWindow::maximize-button:pressed {
    background-color: rgba(0, 0, 0, 0.70) !important;
}

QToolButton#qt_mdi_minimizebutton:pressed,
QToolButton#qt_mdi_maximizebutton:pressed,
QToolButton#qt_mdi_restorebutton:pressed {
    background-color: rgba(51, 51, 51, 0.70) !important;
}

QMdiSubWindow::close-button:hover {
    background-color: rgba(220, 60, 60, 0.90) !important;
}

QMdiSubWindow::close-button:pressed {
    background-color: rgba(220, 60, 60, 0.95) !important;
}

QToolButton#qt_mdi_closebutton:hover {
    background-color: rgba(220, 60, 60, 0.90) !important;
}

QToolButton#qt_mdi_closebutton:pressed {
    background-color: rgba(220, 60, 60, 0.95) !important;
}

/* ===== Custom MDI title bar styling ===== */

/* Custom title bar widget */
QWidget#customTitleBar {
    background-color: #2e2e2e;
    border-bottom: 1px solid #5a6b9a;
    min-height: 24px;
    max-height: 24px;
}

/* Title label */
QLabel#titleLabel {
    font: bold 8pt;
    padding: 0 5px;
    background-color: transparent;
}

/* Title icon */
QLabel#titleIcon {
    background-color: transparent;
    padding: 0 2px;
}

/* Window control buttons base style */
QPushButton#minimizeButton,
QPushButton#maximizeButton,
QPushButton#closeButton {
    background-color: transparent;
    border: none;
    color: #d0d0d0;
    font: bold 8pt;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    margin: 0;
    border-radius: 2px;
}

/* Minimize and maximize button hover */
QPushButton#minimizeButton:hover,
QPushButton#maximizeButton:hover {
    background-color: #4a4a4a;
    color: #ffffff;
}

/* Close button hover */
QPushButton#closeButton:hover {
    background-color: #cc4444;
    color: #ffffff;
}

/* Minimize and maximize button pressed */
QPushButton#minimizeButton:pressed,
QPushButton#maximizeButton:pressed {
    background-color: #2f2f2f;
}

/* Close button pressed */
QPushButton#closeButton:pressed {
    background-color: #aa3333;
}

/* Window container frame */
QFrame#windowContainer {
    border: 2px solid #5a6b9a;
    background-color: #303336;
}

/* ===== Minimized window icon styling ===== */

/* Minimized icon container */
QWidget#minimizedIcon {
    background-color: #3a3a3a;
    border: 1px solid #5a6b9a;
    border-radius: 3px;
}

/* Minimized window title */
QLabel#minimizedTitle {
    color: #d0d0d0;
    font: bold 8pt;
    background-color: transparent;
}

/* Restore button on minimized icon */
QPushButton#restoreButton {
    background-color: transparent;
    border: none;
    color: #d0d0d0;
    font: bold 10pt;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 0;
    margin: 0;
    border-radius: 2px;
}

QPushButton#restoreButton:hover {
    background-color: #4a4a4a;
    color: #ffffff;
}

QPushButton#restoreButton:pressed {
    background-color: #2f2f2f;
}
