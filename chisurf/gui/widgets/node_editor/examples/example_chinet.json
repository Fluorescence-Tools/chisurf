    {"id": "pt_fn", "title": "PT Transform", "type": "pt_transform", "config": {"code": "def f(A=1.0, B=0.15, phase=0.0, span=20.0, freq=1.0):\n    import math\n    N = 400\n    span = float(span)\n    if span <= 0:\n        span = 1.0\n    freq = float(freq)\n    xs = [-span + i * (2.0 * span / (N - 1)) for i in range(N)]\n    ys = [A * math.exp(-B * abs(x)) * math.sin(freq * x + phase) for x in xs]\n    return {'out_00': xs, 'out_01': ys}", "title_color": [170, 140, 210], "body_color": [55, 45, 80]}, "inputs": ["A", "B", "phase", "span", "freq"], "outputs": ["out_00", "out_01"], "pos": [180, 240], "collapsed": false},
