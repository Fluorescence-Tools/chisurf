{
  "id": "fps_json_editor",
  "version": "2.0.0",
  "display_name": "Structure:FRET:FPS JSON Editor",
  "description": "Edit fps.json files for FRET accessible-volume modeling and fetch reference PDB structures by RCSB ID.",
  "authors": ["Thomas-Otavio Peulen"],
  "categories": ["Structure", "FRET"],
  "icon": "icon.png",
  "state_namespace": "fps_json_editor",
  "state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "last_pdb_id": {"type": ["string", "null"]},
      "last_pdb_path": {"type": ["string", "null"]},
      "settings": {"type": "object"}
    }
  },
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "gui": "chisurf.plugins.modelling.fps_json_editor.gui.tool:FpsJsonEditorTool",
    "cli": "fps-json-editor=chisurf.plugins.modelling.fps_json_editor.cli.cli:cli",
    "services": "chisurf.plugins.modelling.fps_json_editor.backend.services:register_services"
  },
  "rpc_methods": [
    {
      "name": "fps_json_editor.pdb.fetch",
      "summary": "Download a PDB file from RCSB by four-character PDB ID.",
      "params_schema": "api.contract#/inputs/FetchPdb",
      "result_schema": "api.contract#/outputs/ServiceResult",
      "long_running": false,
      "cancelable": false
    },
    {
      "name": "fps_json_editor.contract.describe",
      "summary": "Return the FPS JSON Editor workflow contract.",
      "params_schema": {},
      "result_schema": "api.contract",
      "long_running": false,
      "cancelable": false
    }
  ],
  "events": [
    {
      "topic": "fps_json_editor.state.*",
      "description": "State patch events for the FPS JSON Editor plugin"
    },
    {
      "topic": "fps_json_editor.pdb.*",
      "description": "PDB fetch lifecycle events"
    }
  ],
  "dependencies": {},
  "menu_hidden": false,
  "deprecated": false
}
