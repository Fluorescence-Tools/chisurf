{
  "_comment": "Declarative AutoForm layout for the TTTR Audifier: a persistent dock area with the setup page, the detector/channel mixer, declarative audio + waterfall parameter panels, and the reusable general `waterfall` image + audio transport.",
  "sections": [
    {
      "type": "dock_area",
      "title": "TTTR Audifier",
      "persist": "tttr_audifier",
      "sections": [
        {
          "type": "panel",
          "title": "Setup",
          "sections": [
            {"type": "custom", "key": "audifier_setup"}
          ]
        },
        {
          "type": "panel",
          "title": "Mixer",
          "sections": [
            {"type": "custom", "key": "audifier_mix"}
          ]
        },
        {
          "type": "panel",
          "title": "Audio",
          "n_col": 1,
          "sections": [
            {"type": "value", "attr": "bin_width", "label": "Bin width", "kind": "float",
             "decimals": 3, "minimum": 0.001, "maximum": 1.0, "step": 0.01, "suffix": " s",
             "description": "Macro-time bin width used to build the amplitude envelope."},
            {"type": "choice", "attr": "env_mode", "label": "Envelope",
             "options": ["linear", "sqrt", "log"],
             "description": "Envelope compression applied to per-bin photon counts."},
            {"type": "value", "attr": "sample_rate", "label": "Sample rate", "kind": "int",
             "minimum": 8000, "maximum": 192000, "step": 100,
             "description": "Audio sample rate (Hz)."},
            {"type": "value", "attr": "master_gain", "label": "Master gain", "kind": "float",
             "decimals": 2, "minimum": 0.0, "maximum": 2.0, "step": 0.05},
            {"type": "value", "attr": "env_floor", "label": "Env floor", "kind": "float",
             "decimals": 2, "minimum": 0.0, "maximum": 0.99, "step": 0.05},
            {"type": "value", "attr": "env_scale", "label": "Env scale", "kind": "float",
             "decimals": 2, "minimum": 0.1, "maximum": 10.0, "step": 0.1},
            {"type": "value", "attr": "attack_frames", "label": "Attack", "kind": "int",
             "minimum": 0, "maximum": 100},
            {"type": "value", "attr": "release_frames", "label": "Release", "kind": "int",
             "minimum": 0, "maximum": 200}
          ]
        },
        {
          "type": "panel",
          "title": "Waterfall params",
          "n_col": 1,
          "sections": [
            {"type": "choice", "attr": "waterfall_mode", "label": "Mode",
             "options": ["microtime", "lifetime"], "style": "radio",
             "description": "Show a micro-time histogram waterfall or an ILT lifetime waterfall."},
            {
              "type": "panel",
              "title": "Microtime",
              "collapsible": true,
              "collapsed": false,
              "n_col": 1,
              "sections": [
                {"type": "value", "attr": "wf_bin_width", "label": "Bin width", "kind": "float",
                 "decimals": 3, "minimum": 0.001, "maximum": 1.0, "step": 0.01, "suffix": " s"},
                {"type": "value", "attr": "wf_micro_bins", "label": "Micro bins", "kind": "int",
                 "minimum": 32, "maximum": 1024},
                {"type": "toggle", "attr": "wf_log", "label": "Log scale"}
              ]
            },
            {
              "type": "panel",
              "title": "Lifetime",
              "collapsible": true,
              "collapsed": true,
              "n_col": 1,
              "sections": [
                {"type": "value", "attr": "lt_bin_width", "label": "Bin width", "kind": "float",
                 "decimals": 3, "minimum": 0.001, "maximum": 1.0, "step": 0.01, "suffix": " s"},
                {"type": "value", "attr": "lt_tau_min", "label": "τ min", "kind": "float",
                 "decimals": 2, "minimum": 0.1, "maximum": 100.0, "suffix": " ns"},
                {"type": "value", "attr": "lt_tau_max", "label": "τ max", "kind": "float",
                 "decimals": 2, "minimum": 0.1, "maximum": 100.0, "suffix": " ns"},
                {"type": "value", "attr": "lt_n_tau", "label": "N τ points", "kind": "int",
                 "minimum": 20, "maximum": 500},
                {"type": "value", "attr": "lt_reg", "label": "Regularization", "kind": "float",
                 "decimals": 4, "minimum": 1e-06, "maximum": 1.0, "step": 0.001},
                {"type": "toggle_row", "items": [
                  {"attr": "lt_log_tau", "label": "Log τ"},
                  {"attr": "lt_log_amp", "label": "Log amplitude"}
                ]}
              ]
            }
          ]
        },
        {
          "type": "panel",
          "title": "Waterfall",
          "sections": [
            {"type": "custom", "key": "waterfall", "target": "waterfall_payload",
             "options": {"position_source": "waterfall_position"}},
            {"type": "custom", "key": "audifier_transport"}
          ]
        }
      ]
    }
  ]
}
