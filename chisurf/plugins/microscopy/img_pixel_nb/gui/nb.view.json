{
  "_comment": "Number & Brightness imaging tool. AutoForm over NBViewModel: a Controls dock (file; actions in the toolbar) and per-pixel Intensity / B / N / epsilon map docks (reusable `image` section). The detector-window selector lives in each map (channel combo); the Frames dock plays the raw per-frame intensity stack. N&B is computed for every detector window from step-0 Setup.",
  "sections": [
    {
      "type": "dock_area",
      "title": "Number & Brightness",
      "sections": [
        {
          "type": "panel",
          "title": "Controls",
          "collapsed": false,
          "sections": [
            {"type": "value", "attr": "filename", "label": "TTTR file", "kind": "file",
             "description": "PTU/HT3 imaging file; CLSM markers are auto-detected from the header."},
            {"type": "info", "source": "results_html", "height": 90}
          ]
        },
        {"type": "custom", "key": "image", "target": "intensity_map", "title": "Intensity",
         "options": {"colormap": true, "colormap_attr": "colormap",
                     "channel_source": "window_names", "channel_attr": "display_window", "channel_call": "refresh_display"}},
        {"type": "custom", "key": "image", "target": "b_map", "title": "Brightness (B)",
         "options": {"colormap": true, "colormap_attr": "colormap",
                     "channel_source": "window_names", "channel_attr": "display_window", "channel_call": "refresh_display"}},
        {"type": "custom", "key": "image", "target": "n_map", "title": "Number (N)",
         "options": {"colormap": true, "colormap_attr": "colormap",
                     "channel_source": "window_names", "channel_attr": "display_window", "channel_call": "refresh_display"}},
        {"type": "custom", "key": "image", "target": "epsilon_map", "title": "Brightness ε",
         "options": {"colormap": true, "colormap_attr": "colormap",
                     "channel_source": "window_names", "channel_attr": "display_window", "channel_call": "refresh_display"}},
        {"type": "custom", "key": "image", "target": "frame_stack", "title": "Frames (movie)",
         "options": {"colormap": true, "colormap_attr": "colormap", "movie": true, "match_2d": true,
                     "channel_source": "window_names", "channel_attr": "display_window", "channel_call": "refresh_display"}}
      ]
    }
  ]
}
