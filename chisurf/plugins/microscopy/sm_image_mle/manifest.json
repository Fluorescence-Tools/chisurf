{
  "id": "sm_image_mle",
  "version": "2.0.0",
  "display_name": "Imaging:Lifetime:Molecule-wise MLE",
  "description": "Molecule-wise MLE lifetime analysis from TTTR imaging data (PTU).",
  "authors": [
    "Thomas-Otavio Peulen"
  ],
  "categories": [
    "Imaging",
    "Lifetime"
  ],
  "icon": "\ud83d\udd2c",
  "state_namespace": "sm_image_mle",
  "statefulness": {
    "enabled": true,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "gui": "chisurf.plugins.microscopy.sm_image_mle.gui.tool:SmImageMleTool",
    "cli": "sm-image-mle=chisurf.plugins.microscopy.sm_image_mle.cli:cli",
    "services": "chisurf.plugins.microscopy.sm_image_mle.backend.services:register_services"
  },
  "rpc_methods": [
    {
      "name": "sm_image_mle.analyze.run",
      "summary": "Run molecule-wise MLE on PTU files.",
      "params_schema": {
        "type": "object",
        "required": [
          "files",
          "irf_file"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "irf_file": {
            "type": "string"
          },
          "output_dir": {
            "type": "string"
          },
          "settings": {
            "type": "object"
          }
        }
      },
      "result_schema": {
        "type": "object"
      },
      "long_running": true,
      "cancelable": false
    },
    {
      "name": "sm_image_mle.contract.describe",
      "summary": "Return the RPC contract.",
      "params_schema": {},
      "result_schema": {},
      "long_running": false,
      "cancelable": false
    }
  ],
  "events": [
    {
      "topic": "sm_image_mle.state.*",
      "description": "State patch events"
    }
  ],
  "menu_hidden": true
}
