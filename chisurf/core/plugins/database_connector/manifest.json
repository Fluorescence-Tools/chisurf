{
  "id": "database_connector",
  "version": "0.1.0",
  "display_name": "Core:Database Connector",
  "description": "Core database connector services for source/user database resolution, migration, backup, reset, repository access, and FLR CIF import/export.",
  "authors": ["Thomas-Otavio Peulen"],
  "categories": ["Core", "Database", "Fluorescence"],
  "statefulness": {
    "enabled": false,
    "window": {
      "enabled": true,
      "settings_key": null
    }
  },
  "entrypoints": {
    "services": "chisurf.core.plugins.database_connector.services:register_services"
  },
  "rpc_methods": [
    {"name": "database_connector.status"},
    {"name": "database_connector.open"},
    {"name": "database_connector.close"},
    {"name": "database_connector.backup"},
    {"name": "database_connector.reset_from_source"},
    {"name": "database_connector.repository"},
    {"name": "database_connector.import_file"},
    {"name": "database_connector.export_sample"}
  ]
}
