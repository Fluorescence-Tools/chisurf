{
  "_comment": "Editor layout for the dynamic two-state PDA model (PdaDynamicTwoStateModel). PRD-38 model/view-spec split: compute stays in dynamic.py; this JSON is user-editable.",
  "sections": [
    {
      "type": "panel",
      "title": "FRET parameters",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group",
          "target": "fret_parameters",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Two-state kinetics",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "info",
          "text": "Two exchanging states with Gaussian distances (R, s). x1 = steady-state occupancy of state 1; K_ex = mean transitions per observation window (0 = static two-state, large = fast averaging)."
        },
        {
          "type": "parameter_group",
          "target": "states",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Corrections / nuisance",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group",
          "target": "nuisance",
          "collapsible": false
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "distribution",
      "options": {
        "with_residual_panel": true,
        "distribution_options": {
          "S1/(S0+S1)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S1/(S0+S1)"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "E (FRET efficiency)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "E"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "R [\u00c5]": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 100.0,
                "x_min": 20.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "R"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    },
    {
      "key": "residual2d",
      "options": {
        "accessor": "chisurf.core.models.pda.common:get_pda_residual_image",
        "accessor_kwargs": {
          "weighted": true
        }
      }
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    }
  ]
}
