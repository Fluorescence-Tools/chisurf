{
  "_comment": "Editor layout for the discrete PDA model (PdaSimpleModel). PRD-38 model/view-spec split: compute stays in simple.py; this JSON is user-editable (reorder sections, retitle, add plots).",
  "sections": [
    {
      "type": "panel",
      "title": "Photon-number range",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "parameter_group",
          "target": "nuisance",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Background",
      "collapsible": true,
      "collapsed": true,
      "sections": [
        {
          "type": "parameter_group",
          "target": "background",
          "collapsible": false
        }
      ]
    },
    {
      "type": "panel",
      "title": "Species (discrete)",
      "collapsible": true,
      "collapsed": false,
      "sections": [
        {
          "type": "toggle_row",
          "items": [
            {
              "target": "pch0",
              "attr": "absolute_amplitudes",
              "label": "Abs."
            },
            {
              "target": "pch0",
              "attr": "normalize_amplitudes",
              "label": "Norm."
            }
          ]
        },
        {
          "type": "dynamic_group",
          "target": "pch0",
          "rows_source": "_pch0_parameter_rows",
          "row_width": 2,
          "append_method": "append",
          "remove_method": "pop",
          "min_rows": 1,
          "collapsible": false
        }
      ]
    }
  ],
  "plots": [
    {
      "key": "distribution",
      "options": {
        "with_residual_panel": true,
        "distribution_options": {
          "S1/(S0+S1)": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 1.0,
                "x_min": 0.0,
                "log_x": false,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S1/(S0+S1)"
              }
            },
            "scale_x": "lin",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          },
          "S0/S1": {
            "attribute": "fit",
            "accessor": "chisurf.core.models.pda.common:get_pda_distribution",
            "accessor_kwargs": {
              "kw_hist": {
                "x_max": 500.0,
                "x_min": 0.01,
                "log_x": true,
                "n_bins": 81,
                "n_min": 10,
                "histogram": "S0/S1"
              }
            },
            "scale_x": "log",
            "curve_options": {
              "stepMode": false,
              "connect": "all",
              "multi_curve": true,
              "symbol": [
                "None",
                "None",
                "None"
              ],
              "pen": [
                "b",
                "r",
                "k"
              ]
            }
          }
        }
      }
    },
    {
      "key": "residual",
      "options": {}
    },
    {
      "key": "residual2d",
      "options": {
        "accessor": "chisurf.core.models.pda.common:get_pda_residual_image",
        "accessor_kwargs": {
          "weighted": true
        }
      }
    },
    {
      "key": "fit_info",
      "options": {}
    },
    {
      "key": "parameter_scan",
      "options": {}
    }
  ]
}
