   _item_type.code           code
   _item.mandatory_code      yes
   _chisurf_schema.table_name  mfdb_study_member
   _chisurf_schema.column_name study_id
   _item_description.description
;     References mfdb_study.study_id (a logical reference; the dictionary-generated
;     study_id is not emitted as a PRIMARY KEY, so no hard FK — the repository
;     manages study membership integrity, as for mfdb_operation.protocol_id).

save__mfdb_study_member.member_type
   _item.name                "_mfdb_study_member.member_type"
