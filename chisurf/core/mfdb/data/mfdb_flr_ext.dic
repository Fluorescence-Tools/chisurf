## mfdb_reagent_usage (PRD-15)          #
########################################

save_mfdb_reagent_usage
   _category.id              mfdb_reagent_usage
   _category.description
;     Many-to-many link of a reagent lot to what used it — an operation (a measurement
;     or processing step), a setup (e.g. an installed filter set), or a sample (e.g. a
;     labeling dye lot).  Orthogonal to those tables.
;
   _category.mandatory_code  no
   _category_key.name        "_mfdb_reagent_usage.usage_row_id"

save__mfdb_reagent_usage.usage_row_id
   _item.name                "_mfdb_reagent_usage.usage_row_id"
   _item.category_id         mfdb_reagent_usage
   _item_type.code           int
   _item.mandatory_code      yes
   _chisurf_schema.table_name  mfdb_reagent_usage
   _chisurf_schema.column_name usage_row_id

save__mfdb_reagent_usage.lot_id
   _item.name                "_mfdb_reagent_usage.lot_id"
   _item.category_id         mfdb_reagent_usage
   _item_type.code           code
   _item.mandatory_code      yes
   _chisurf_schema.table_name  mfdb_reagent_usage
   _chisurf_schema.column_name lot_id
   _item_description.description
;     References mfdb_reagent_lot.lot_id (a logical reference; the dictionary-generated
;     lot_id code key is not emitted as a PRIMARY KEY, so no hard FK — the repository
;     manages reagent-usage integrity, as for mfdb_study_member.study_id).

save__mfdb_reagent_usage.target_type
   _item.name                "_mfdb_reagent_usage.target_type"
