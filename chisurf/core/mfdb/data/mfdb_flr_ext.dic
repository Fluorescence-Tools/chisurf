save_mfdb_study_member
   _category.id              mfdb_study_member
   _category.description
;     Many-to-many membership linking existing samples / artifacts into a study.
;     member_type is 'sample' or 'artifact'; (study_id, member_type, member_id) is
;     unique (enforced by the repository).
;
   _category.mandatory_code  no
   _category_key.name        "_mfdb_study_member.member_row_id"

save__mfdb_study_member.member_row_id
   _item.name                "_mfdb_study_member.member_row_id"
