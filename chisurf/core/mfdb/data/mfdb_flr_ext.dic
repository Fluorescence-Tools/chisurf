   _item_type.code           text
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name payload_json
   _item_description.description
;     JSON-encoded enriched action payload (opaque to the database).

save__mfdb_event_log.source_uid
   _item.name                "_mfdb_event_log.source_uid"
   _item.category_id         mfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name source_uid

save__mfdb_event_log.target_uid
   _item.name                "_mfdb_event_log.target_uid"
   _item.category_id         mfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name target_uid

save__mfdb_event_log.operation_id
   _item.name                "_mfdb_event_log.operation_id"
   _item.category_id         mfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name operation_id
   _chisurf_schema.foreign_key mfdb_operation(operation_id) ON DELETE SET NULL
   _item_description.description
;     Links a coarse event to the semantic mfdb_operation it produced (if any).

save__mfdb_event_log.event_timestamp
   _item.name                "_mfdb_event_log.event_timestamp"
   _item.category_id         mfdb_event_log
   _item_type.code           datetime
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name event_timestamp
   _item_description.description
;     The event's own ISO-8601 timestamp (distinct from the audit created_at).

save__mfdb_event_log.replayable
   _item.name                "_mfdb_event_log.replayable"
   _item.category_id         mfdb_event_log
   _item_type.code           boolean
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name replayable

save__mfdb_event_log.side_effect_class
   _item.name                "_mfdb_event_log.side_effect_class"
   _item.category_id         mfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name side_effect_class

save__mfdb_event_log.history_version
   _item.name                "_mfdb_event_log.history_version"
   _item.category_id         mfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_event_log
   _chisurf_schema.column_name history_version

########################################
## mfdb_protocol (PRD-14 LIMS P3)       #
########################################

save_mfdb_protocol
   _category.id              mfdb_protocol
   _category.description
;     A named, versioned procedure (measurement / processing / analysis) that
;     operations reference, so every recorded operation names the exact procedure +
;     version it executed ("re-run protocol X v3").  Append-only by version: editing
;     a protocol creates a new row (new protocol_id) with version = max+1 for that
;     name; operations keep the version they ran.  The parameter schema is the
;     operation_type's declared schema (mfdb_operation_parameter_def, PRD-11) — no
;     forked parameter stack.
;
   _category.mandatory_code  no
   _category_key.name        "_mfdb_protocol.protocol_id"

save__mfdb_protocol.protocol_id
   _item.name                "_mfdb_protocol.protocol_id"
   _item.category_id         mfdb_protocol
   _item_type.code           code
   _item.mandatory_code      yes
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name protocol_id

save__mfdb_protocol.name
   _item.name                "_mfdb_protocol.name"
   _item.category_id         mfdb_protocol
   _item_type.code           code
   _item.mandatory_code      yes
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name name
   _item_description.description
;     The protocol's stable name; shared across versions (UNIQUE with version,
;     enforced by the repository).

save__mfdb_protocol.version
   _item.name                "_mfdb_protocol.version"
   _item.category_id         mfdb_protocol
   _item_type.code           int
   _item.mandatory_code      yes
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name version

save__mfdb_protocol.category
   _item.name                "_mfdb_protocol.category"
   _item.category_id         mfdb_protocol
   _item_type.code           code
   _item.mandatory_code      yes
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name category
    loop_
    _item_enumeration.value
      measurement
      processing
      analysis

save__mfdb_protocol.description
   _item.name                "_mfdb_protocol.description"
   _item.category_id         mfdb_protocol
   _item_type.code           text
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name description

save__mfdb_protocol.operation_type
   _item.name                "_mfdb_protocol.operation_type"
   _item.category_id         mfdb_protocol
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name operation_type
   _item_description.description
;     The PRD-11 operation kind this protocol realizes; its declared parameter
;     schema (mfdb_operation_parameter_def) is the protocol's parameter schema.

save__mfdb_protocol.setup_id
   _item.name                "_mfdb_protocol.setup_id"
   _item.category_id         mfdb_protocol
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name setup_id
   _chisurf_schema.foreign_key  mfdb_setup(setup_id)

save__mfdb_protocol.created_by_user_id
   _item.name                "_mfdb_protocol.created_by_user_id"
   _item.category_id         mfdb_protocol
   _item_type.code           code
   _item.mandatory_code      no
   _chisurf_schema.table_name  mfdb_protocol
   _chisurf_schema.column_name created_by_user_id
   _chisurf_schema.foreign_key  flr_sample_users(user_id)

save__mfdb_protocol.is_public
   _item.name                "_mfdb_protocol.is_public"
   _item.category_id         mfdb_protocol
