[Setup]
AppId={{ AppId }}
AppName={{ AppName }}
AppVerName={{ AppVerName }}
AppVersion={{ AppVersion }}
AppPublisher={{ AppPublisher }}
AppPublisherURL={{ AppURL }}
AppSupportURL={{ AppURL }}
AppUpdatesURL={{ AppURL }}
UsePreviousAppDir=no
DefaultGroupName={{ AppName }}
LicenseFile={{ LicenseFile }}
OutputDir={{ Output_dir }}
OutputBaseFilename=ChiSurf-Windows-Setup-{{ AppVersion }}
SetupIconFile={{ SetupIconFile }}
Compression=lzma2/ultra64
InternalCompressLevel=max
SolidCompression=yes
LZMAUseSeparateProcess=yes
CompressionThreads=auto
UninstallLogMode=overwrite
DirExistsWarning=yes
UninstallDisplayIcon="{app}\icons\icon.ico"
DisableProgramGroupPage=no

; IMPORTANT: built-in scope dialog + per-user default
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

; Default dir decided at runtime based on chosen scope
DefaultDirName={code:GetInstallDir}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Icon files must be explicitely included
Source: ".\icons\*.ico"; DestDir: "{app}\icons"
; Use \* with recursesubdirs so Inno includes both root-level runtime files
; (for example python.exe and DLLs) and nested package dependencies.
Source: "{{ App_dir }}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Launch via pythonw -m chisurf: relocation-proof (no Scripts\*.exe path
; baked in), so no install-time launcher fixing is needed.
Name: "{group}\ChiSurf"; Filename: "{app}\pythonw.exe"; Parameters: "-m chisurf"; WorkingDir: "{app}"; IconFilename: "{app}\icons\icon.ico"
Name: "{group}\Uninstall ChiSurf"; Filename: "{uninstallexe}"
Name: "{commondesktop}\ChiSurf"; Filename: "{app}\pythonw.exe"; Parameters: "-m chisurf"; WorkingDir: "{app}"; Tasks: desktopicon; Check: IsAdminInstallMode; IconFilename: "{app}\icons\icon.ico"
Name: "{userdesktop}\ChiSurf";   Filename: "{app}\pythonw.exe"; Parameters: "-m chisurf"; WorkingDir: "{app}"; Tasks: desktopicon; Check: not IsAdminInstallMode; IconFilename: "{app}\icons\icon.ico"

[UninstallDelete]
Type: files; Name: "{app}\install.log"

[Code]
function GetInstallDir(Param: string): string;
begin
  if IsAdminInstallMode then
    Result := ExpandConstant('{pf}\{{ AppName }}')
  else
    // Per-user installs typically go under LocalAppData\Programs
    Result := ExpandConstant('{localappdata}\Programs\{{ AppName }}');
end;
